{
  "name": "@sestina/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first research process debugger for Codex projects",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "sestina": "./dist/main.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && node ../../scripts/build-cli.mjs",
    "test": "vitest run --root ../.. --project unit apps/cli/test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sestina/core": "workspace:*",
    "@sestina/mcp": "workspace:*",
    "@sestina/skills": "workspace:*",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
