{
  "name": "@sestina/research-room",
  "version": "0.2.0",
  "private": true,
  "description": "Loopback-only local Research Room for Sestina",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sestina-research-room": "./dist/main.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json && node ../../scripts/build-research-room.mjs",
    "test": "vitest run --root ../.. --project unit apps/research-room/test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@sestina/core": "workspace:*",
    "@sestina/mcp": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@sestina/storage": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "vitest": "^3.0.0"
  }
}
