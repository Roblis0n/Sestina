{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@sestina/schema": [
        "packages/schema/src/index.ts"
      ],
      "@sestina/storage": [
        "packages/storage/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/vitest.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "eslint.config.mjs",
    "vitest.bench.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage"
  ]
}
