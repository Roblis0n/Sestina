{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "invoke",
          "outcome",
          "requiresUserDecision",
          "foregroundCorrections",
          "resumedOriginalTask",
          "requestsPrivateReasoning",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "invoke": { "type": "boolean" },
          "outcome": {
            "type": "string",
            "enum": ["allow", "steer", "unknown"]
          },
          "requiresUserDecision": { "type": "boolean" },
          "foregroundCorrections": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "resumedOriginalTask": { "type": "boolean" },
          "requestsPrivateReasoning": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
