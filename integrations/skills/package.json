{
  "name": "@sestina/skills",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node --experimental-strip-types generate.ts --write && node evals/agent-corrector/generate-cases.mjs --write",
    "check": "node --experimental-strip-types generate.ts --check && node evals/agent-corrector/generate-cases.mjs --check",
    "eval:prompt": "node evals/agent-corrector/build-eval-prompt.mjs",
    "eval:score": "node evals/agent-corrector/score-results.mjs",
    "test": "vitest run --root ../.. --project unit integrations/skills/test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
