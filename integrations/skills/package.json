{
  "name": "@sestina/skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node --experimental-strip-types generate.ts --write",
    "check": "node --experimental-strip-types generate.ts --check",
    "test": "vitest run --root ../.. --project unit integrations/skills/test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
