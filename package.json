{
  "name": "sestina",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ipc": "vitest run --project ipc",
    "test:desktop": "vitest run --project desktop",
    "test:e2e": "playwright test",
    "test:e2e:ri40": "pnpm --filter @sestina/mcp build && vitest run --config tests/e2e/vitest.ri40.config.ts",
    "test:e2e:codex": "pnpm --filter @sestina/mcp build && vitest run --config tests/e2e/vitest.codex.config.ts",
    "eval:locked": "node --experimental-strip-types researchbench/tools/run-evaluation.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "docs:check": "node scripts/check-doc-links.mjs",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && node scripts/check-no-placeholders.mjs",
    "repo:check": "node scripts/check-repository-shape.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:authority": "node scripts/verify-authority.mjs",
    "verify:package": "node scripts/verify-clean-package.mjs",
    "demo:offline": "pnpm --filter @sestina/cli build && node scripts/run-offline-demos.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e:ri40 && pnpm docs:check && pnpm repo:check && pnpm verify:architecture && pnpm verify:authority && pnpm verify:package && pnpm demo:offline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.0"
  }
}
